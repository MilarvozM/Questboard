// Questboard default settings. Do not edit this file: updates replace it.
// To change a value, create config.jsonc next to this file and put in only the keys you want to change.
// A value Questboard can't use falls back to the default here, and the terminal names the key.
{
  // ---------------------------------------------------------------- server

  // Port of the local web page: http://localhost:<port>. The server only answers this computer.
  "port": 4747,
  // Open the browser when Questboard starts.
  "openBrowser": true,
  // Folder for quests, completed quests, guilds, settings and player stats.
  // A relative path counts from this folder; ~ means your home folder. Example: "~/Obsidian/Vault/Quests"
  "dataDir": "data",
  // Largest request the page may send, in megabytes (an import of pasted or dropped files, a player.json).
  "maxRequestMB": 10,

  // ---------------------------------------------------------------- data folder scanning

  "scan": {
    // Folders whose names start with any of these are skipped (.obsidian, .trash, .git, .backups).
    "skipFolderPrefixes": ["."],
    // Wait this long after a file change before reading it, so a save in several writes is read once.
    "watchDebounceMs": 200,
    // Where the system can't watch a folder tree (Linux on Node 18), rescan the folder this often instead.
    "pollSeconds": 3
  },

  // ---------------------------------------------------------------- quests

  // XP for completing a quest of each type, before the grade multiplier. A quest's own "xp:" overrides this.
  "xp": { "main": 300, "side": 100, "activity": 20 },
  // XP awarded = quest XP × the multiplier of the grade earned.
  "gradeMultiplier": { "S": 1.5, "A": 1.0, "B": 0.75, "C": 0.5 },
  // Where the S line sits when a quest doesn't set "target:", as a share of the time from accepting to the deadline.
  "sLineAt": 0.75,
  // Finishing up to this many hours after the deadline earns B; later earns C.
  "gradeBGraceHours": 24,
  // Level n needs levelXpStep × n XP to reach the next level.
  "levelXpStep": 250,
  // Most quests the Favorites panel accepts from the star button.
  "favoritesMax": 5,
  // With nothing tracked, a quest (or its current step) due within this many days counts as urgent in the focus strip.
  "urgentDays": 3,
  // Countdowns under this many hours turn red and pulse.
  "countdownRedHours": 24,
  // Longest short name shown on the calendar, in characters.
  "shortNameMax": 10,
  // Longest title part of a new quest's file name, in characters.
  "fileSlugMax": 24,
  // Length of the short id used in file names when a title has no Latin letters to make a name from.
  "fileIdLength": 5,

  // ---------------------------------------------------------------- interface

  // Starting values for the choices in the settings popup. Once changed there, data/settings.json holds them.
  "defaults": {
    // Interface language: a file name in locales/ ("en", "zh").
    "language": "en",
    // Visual style: a file name in styles/ ("terminal", "chronicle").
    "style": "terminal",
    // Sound cues on or off.
    "sound": true,
    // First day of the week in the calendar and the player page: "sunday" or "monday".
    "weekStart": "sunday",
    // What the calendar draws: "quests", "steps" (quests + steps) or "everything" (adds closed quests).
    "calendarMode": "quests"
  },
  // Keep sound cues silent when the system asks for reduced motion.
  "muteWithReducedMotion": false,
  // How many changes Ctrl/Cmd+Z can undo in one session.
  "undoDepth": 20,
  // How long the objective banner stays on screen, in milliseconds.
  "bannerMs": 2000,
  // How long the larger OBJECTIVE COMPLETE banner stays, in milliseconds.
  "bannerCompleteMs": 2600,

  // Keyboard shortcuts. Values are browser key names: a letter, a digit, or a name such as "Escape".
  // An uppercase letter means Shift + that letter. "Mod+" means Ctrl on Windows and Linux, Cmd on macOS.
  "keys": {
    "capture": "n",
    "newQuest": "N",
    "viewLog": "1",
    "viewCalendar": "2",
    "viewJournal": "3",
    "track": "t",
    "favorite": "s",
    "markdown": "m",
    "complete": "c",
    "logEntry": "l",
    "undo": "Mod+z",
    "close": "Escape",
    // On the results screen after a quest completes
    "debrief": "d",
    "openJournal": "j"
  }
}
